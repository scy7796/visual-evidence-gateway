{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VisionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "answer", "evidence", "relevant_text", "uncertainty", "confidence", "model_id", "images_seen"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed", "unreadable"]
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "evidence": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding", "location", "confidence", "image_index"],
        "properties": {
          "finding": {"type": "string", "minLength": 1, "maxLength": 20000},
          "location": {"type": "string", "maxLength": 2000},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "image_index": {"type": "integer", "minimum": 0}
        }
      }
    },
    "relevant_text": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "maxLength": 20000}
    },
    "uncertainty": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "maxLength": 4000}
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "images_seen": {
      "type": "integer",
      "minimum": 1
    }
  }
}
